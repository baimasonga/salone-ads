{
  "name": "manohub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "vite build",
    "start": "node dist/server.cjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name=manohub",
    "deploy:containers": "wrangler deploy --config wrangler.containers.toml",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "lint:worker": "tsc --noEmit -p worker/tsconfig.json",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.accessibility.config.ts",
    "test:low-bandwidth": "node scripts/validate-low-bandwidth.mjs",
    "test:performance": "node scripts/run-performance-gate.mjs",
    "test:rls": "node scripts/verify-rls-security.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "7.18.1",
    "resend": "6.18.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  }
}
