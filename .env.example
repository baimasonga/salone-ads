# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase project API URL and
# publishable (anon) key. Read by both the Vite client bundle (import.meta.env)
# and the Express server (process.env via dotenv) — safe to expose to the
# browser, RLS policies enforce access control.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
VITE_MANOHUB_BANK_INSTRUCTIONS="Confirmed ManoHub bank account instructions"
VITE_MANOHUB_MOBILE_MONEY_INSTRUCTIONS="Confirmed ManoHub mobile-money instructions"
VITE_MANOHUB_FINANCE_CONTACT="Confirmed ManoHub Finance contact"

# Server-only audience email delivery configuration. Never prefix these with
# VITE_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="Manohub <updates@YOUR_VERIFIED_DOMAIN>"
RESEND_WEBHOOK_SECRET="whsec_YOUR_RESEND_SIGNING_SECRET"
EMAIL_DISPATCH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
